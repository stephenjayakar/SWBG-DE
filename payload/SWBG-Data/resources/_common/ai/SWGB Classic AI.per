  (set-goal ce-castle-attempt ce-YES)
)
; EMPIRE/main/2045
(defrule
  (civ-selected 1)
  (goal ce-castle-attempt ce-ANOTHER)
  (difficulty <= moderate)
  (current-age >= 3)
  (up-compare-goal 120 c:> ce-civ-dark-rush)
  (building-type-count-total ce-bldg-govtctr < 3)
  (can-build ce-bldg-govtctr)
  (nor (goal ce-wonder-attempt ce-POSSIBLE) (goal ce-rush-control ce-RUSHING))
  =>
  (build-forward ce-bldg-govtctr)
  (set-goal ce-castle-attempt ce-NO)
)
