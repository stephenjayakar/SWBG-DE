#load-if-defined WONDER-RACE
; EMPIRE/main/1
(defrule
  (civ-selected 1)
  (current-age == 3)
  (wood-amount >= 3000)
  (gold-amount >= 3000)
  (stone-amount >= 3000)
  =>
  (set-goal ce-upgrade-conflict ce-NOTICE)
  (disable-self)
)
; EMPIRE/main/2
(defrule
  (civ-selected 1)
  (can-build-with-escrow ce-bldg-monument)
  =>
  (release-escrow wood)
  (release-escrow gold)
  (release-escrow stone)
  (set-strategic-number sn-maximum-town-size 10)
  (set-strategic-number sn-percent-civilian-builders 90)
  (set-strategic-number sn-cap-civilian-builders 50)
  (set-strategic-number sn-percent-civilian-gatherers 10)
  (build ce-bldg-monument)
  (disable-self)
)
; EMPIRE/main/3
(defrule
  (civ-selected 1)
  (goal ce-age-advancement ce-NO)
  (current-age == 0)
  (game-time >= 600)
  (or (players-current-age any-enemy > 0) (civilian-population >= ce-civ-dark-rush))
  =>
  (set-goal ce-upgrade-conflict ce-NOTICE)
)
; EMPIRE/main/4
(defrule
  (civ-selected 1)
  (goal ce-age-advancement ce-NO)
  (current-age == 1)
  (up-compare-goal 116 c:> 450)
  =>
  (set-goal ce-upgrade-conflict ce-NOTICE)
)
; EMPIRE/main/5
(defrule
  (civ-selected 1)
  (goal ce-age-advancement ce-NO)
  (current-age == 2)
  (up-compare-goal 116 c:> 300)
  =>
  (set-goal ce-upgrade-conflict ce-NOTICE)
)
; EMPIRE/main/6
(defrule
  (civ-selected 1)
  (can-research-with-escrow 1)
  (or (players-current-age every-human >= 1) (difficulty <= moderate))
  =>
  (release-escrow food)
  (research 1)
  (set-goal ce-resource-needed 0)
  (set-goal ce-age-advancement ce-NOTICE)
  (set-goal ce-upgrade-conflict ce-NO)
  (disable-timer ce-t-ageup)
  (enable-timer ce-t-ageup 140)
)
; EMPIRE/main/7
(defrule
  (civ-selected 1)
  (can-research-with-escrow 2)
  (or (difficulty <= moderate) (and (players-current-age every-human == 2) (difficulty == easy)))
  =>
  (release-escrow food)
  (release-escrow gold)
  (research 2)
  (set-goal ce-resource-needed 0)
  (set-goal ce-age-advancement ce-NOTICE)
  (set-goal ce-upgrade-conflict ce-NO)
  (disable-timer ce-t-ageup)
  (enable-timer ce-t-ageup 170)
)
; EMPIRE/main/8
(defrule
  (civ-selected 1)
  (can-research-with-escrow 3)
  (or (difficulty <= moderate) (and (players-current-age every-human == 3) (difficulty == easy)))
  =>
  (release-escrow food)
  (release-escrow gold)
  (research 3)
  (set-goal ce-resource-needed 0)
  (set-goal ce-age-advancement ce-NOTICE)
  (set-goal ce-upgrade-conflict ce-NO)
  (disable-timer ce-t-ageup)
  (enable-timer ce-t-ageup 200)
)
; EMPIRE/main/9
(defrule
  (civ-selected 1)
  (current-age < 3)
  (timer-triggered ce-t-ageup)
  (goal ce-age-advancement ce-NOTICE)
  =>
  (disable-timer ce-t-ageup)
  (set-goal ce-age-advancement ce-NO)
)
; EMPIRE/main/10
(defrule
  (civ-selected 1)
  (game-time > 3)
  (not (up-resource-amount 1997 == 15))
  =>
  (set-strategic-number sn-minimum-water-body-size-for-dock 3000)
  (disable-self)
)
; EMPIRE/main/11
(defrule
  (civ-selected 1)
  (up-resource-amount 1997 == 47)
  (true)
  =>
  (set-goal 1 1)
  (disable-self)
)
; EMPIRE/main/12
(defrule
  (civ-selected 1)
  (up-resource-amount 1997 == 9)
  (true)
  =>
  (set-goal 1 1)
  (disable-self)
)
; EMPIRE/main/13
(defrule
  (civ-selected 1)
  (up-resource-amount 1997 == 23)
  (true)
  =>
  (set-goal 1 1)
  (disable-self)
)
; EMPIRE/main/14
(defrule
  (civ-selected 1)
  (up-resource-amount 1997 == 14)
  (true)
  =>
  (set-goal 1 1)
  (disable-self)
)
; EMPIRE/main/15
(defrule
  (civ-selected 1)
