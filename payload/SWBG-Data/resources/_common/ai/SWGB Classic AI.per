; REBEL/main/1
(defrule
  (civ-selected 2)
  (current-age == 3)
  (wood-amount >= 3000)
  (gold-amount >= 3000)
  (stone-amount >= 3000)
  =>
  (set-goal cr-upgrade-conflict cr-NOTICE)
  (disable-self)
)
; REBEL/main/2
(defrule
  (civ-selected 2)
  (can-build-with-escrow cr-bldg-monument)
  =>
  (release-escrow wood)
  (release-escrow gold)
  (release-escrow stone)
  (set-strategic-number sn-maximum-town-size 10)
  (set-strategic-number sn-percent-civilian-builders 90)
  (set-strategic-number sn-cap-civilian-builders 50)
  (set-strategic-number sn-percent-civilian-gatherers 10)
  (build cr-bldg-monument)
  (disable-self)
)
; REBEL/main/3
(defrule
  (civ-selected 2)
  (goal cr-age-advancement cr-NO)
  (current-age == 0)
  (game-time >= 600)
  (or (players-current-age any-enemy > 0) (civilian-population >= cr-civ-dark-rush))
  =>
  (set-goal cr-upgrade-conflict cr-NOTICE)
)
