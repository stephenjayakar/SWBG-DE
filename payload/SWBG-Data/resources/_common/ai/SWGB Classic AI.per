; Original Computer Classic port, experimental; select this AI explicitly.
; Source provenance and compatibility exceptions: ORIGINAL-AI.md.
; Extreme loads the Hardest rules through twin conditionals (classic_ai_extreme.py).
; SWGB queues a building type only when none is waiting or under construction (DE new building system off).
(defrule (true) => (set-goal 100 2) (set-strategic-number sn-enable-new-building-system 0)
 (set-strategic-number sn-initial-exploration-required 0) (disable-self))
(defrule (true) => (up-get-fact player-number 0 104) (xs-script-call "swgbClassicObserve"))
; Power placement (classic_ai_power_placement.py): SWGB engine placement put buildings in Power Core range.
(defrule (true) => (set-strategic-number sn-placement-zone-size 7)
 (set-strategic-number sn-placement-fail-delta 1) (disable-self))
(defrule (up-compare-goal 101 c:== 0) => (set-strategic-number sn-placement-zone-size 7))
(defrule (strategic-number sn-placement-zone-size > 20) =>
 (set-strategic-number sn-placement-zone-size 7))
; Source current-age-time emulation (goals 114-116).
; DE restarts its own age clock only for AoE2 age technologies, not SWGB Tech Levels.
(defrule (true) => (up-get-fact current-age 0 116))
(defrule (up-compare-goal 116 g:!= 114) =>
 (up-modify-goal 114 g:= 116) (up-get-fact game-time 0 115))
(defrule (true) => (up-get-fact game-time 0 116) (up-modify-goal 116 g:- 115))
; Isolated nine-rule loop. Do not insert conditional load directives here.
; Source animal decisions are independent of the Computer Classic rule graph.
(defrule (true) => (xs-script-call "swgbClassicNurseryBegin"))
(defrule (true) =>
 (xs-script-call "swgbClassicNurseryNext")
 (up-reset-search 1 1 1 1))
(defrule (up-compare-goal 106 c:> -1)
 (up-set-target-by-id g: 106) =>
 (up-get-object-data object-data-action 109)
 (up-get-object-data object-data-order 110)
 (up-reset-search 1 1 1 1))
(defrule (up-compare-goal 106 c:> -1)
 (up-compare-goal 109 c:== -1) (up-compare-goal 110 c:== -1) =>
 (xs-script-call "swgbClassicNurseryChoose"))
(defrule (up-compare-goal 107 c:> -1) (up-compare-goal 108 c:== 7)
 (up-set-target-by-id g: 107) =>
 (up-get-object-data object-data-garrison-count 111)
 (xs-script-call "swgbClassicNurseryCapacity")
 (up-reset-search 1 1 1 1))
(defrule (up-compare-goal 107 c:> -1) (up-compare-goal 108 c:== 7)
 (up-set-target-by-id g: 107) =>
 (up-reset-search 1 1 1 1)
 (up-add-object-by-id search-local g: 106)
 (up-target-objects 1 action-garrison -1 -1)
 (up-reset-search 1 1 1 1))
(defrule (up-compare-goal 107 c:> -1) (up-compare-goal 108 c:== 1)
 (up-set-target-by-id g: 107) =>
 (up-reset-search 1 1 1 1)
 (up-add-object-by-id search-local g: 106)
 (up-target-objects 1 action-move -1 -1)
 (up-reset-search 1 1 1 1))
(defrule (up-compare-goal 106 c:> -1) => (up-jump-rule -7))
(defrule (true) => (up-reset-search 1 1 1 1))

