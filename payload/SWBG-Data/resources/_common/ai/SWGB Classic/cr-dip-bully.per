#load-if-not-defined TEAMS-LOCKED
#load-if-defined DIFFICULTY-EASIEST
; REBEL/dip-bully/1
(defrule
  (civ-selected 2)
  (true)
  =>
  (set-stance every-human neutral)
  (set-stance every-computer neutral)
  (disable-self)
)
; REBEL/dip-bully/2
(defrule
  (civ-selected 2)
  (cc-players-building-type-count any-human cr-bldg-spaceport > 0)
  =>
  (generate-random-number 2)
  (set-goal cr-personality 50)
  (disable-self)
)
; REBEL/dip-bully/3
(defrule
  (civ-selected 2)
  (goal cr-personality 50)
  (random-number == 1)
  =>
  (disable-timer cr-t-chat)
  (enable-timer cr-t-chat 10)
  (set-goal cr-personality 4)
  (disable-self)
)
; REBEL/dip-bully/4
(defrule
  (civ-selected 2)
  (goal cr-personality 50)
  =>
  (set-goal cr-personality 0)
  (disable-self)
)
; REBEL/dip-bully/5
(defrule
  (civ-selected 2)
  (goal cr-personality 4)
  (taunt-detected any-computer 218)
  =>
  (set-goal cr-personality 0)
  (acknowledge-taunt this-any-computer 218)
  (disable-timer cr-t-chat)
  (disable-self)
)
; REBEL/dip-bully/6
(defrule
  (civ-selected 2)
  (goal cr-personality 4)
  (timer-triggered cr-t-chat)
  =>
  (set-goal cr-personality cr-ALLY)
  (disable-timer cr-t-chat)
  (set-stance every-human neutral)
  (set-stance every-computer neutral)
  (chat-to-player-using-id every-human 942000)
  (chat-to-player-using-id every-computer 942400)
  (disable-self)
)
; REBEL/dip-bully/7
(defrule
  (civ-selected 2)
  (goal cr-personality cr-ALLY)
  (or
  (or (players-tribute any-human-neutral wood >= 100) (players-tribute any-human-neutral food >= 100))
  (or (players-tribute any-human-neutral gold >= 100) (players-tribute any-human-neutral stone >= 100))
)
  =>
  (chat-to-player-using-id this-any-human-neutral 942002)
  (chat-to-player-using-id this-any-human-neutral 942003)
  (set-stance this-any-human-neutral ally)
  (set-stance every-computer enemy)
  (disable-self)
)
#end-if
