(defconst SWGB_CLASSIC_DIP_BULLY 1)
#load-if-not-defined TEAMS-LOCKED
#load-if-defined DIFFICULTY-EASIEST
; EMPIRE/dip-bully/1
(defrule
  (civ-selected 1)
  (true)
  =>
  (set-stance every-human neutral)
  (set-stance every-computer neutral)
  (disable-self)
)
; EMPIRE/dip-bully/2
(defrule
  (civ-selected 1)
  (cc-players-building-type-count any-human ce-bldg-spaceport > 0)
  =>
  (generate-random-number 2)
  (set-goal ce-personality 50)
  (disable-self)
)
; EMPIRE/dip-bully/3
(defrule
  (civ-selected 1)
  (goal ce-personality 50)
  (random-number == 1)
  =>
  (disable-timer ce-t-chat)
  (enable-timer ce-t-chat 10)
  (set-goal ce-personality 4)
  (disable-self)
)
; EMPIRE/dip-bully/4
(defrule
  (civ-selected 1)
  (goal ce-personality 50)
  =>
  (set-goal ce-personality 0)
  (disable-self)
)
; EMPIRE/dip-bully/5
(defrule
  (civ-selected 1)
  (goal ce-personality 4)
  (taunt-detected any-computer 218)
  =>
  (set-goal ce-personality 0)
  (acknowledge-taunt this-any-computer 218)
  (disable-timer ce-t-chat)
  (disable-self)
)
; EMPIRE/dip-bully/6
(defrule
  (civ-selected 1)
  (goal ce-personality 4)
  (timer-triggered ce-t-chat)
  =>
  (set-goal ce-personality ce-ALLY)
  (disable-timer ce-t-chat)
  (set-stance every-human neutral)
  (set-stance every-computer neutral)
  (chat-to-player-using-id every-human 942000)
  (chat-to-player-using-id every-computer 942400)
  (disable-self)
)
; EMPIRE/dip-bully/7
(defrule
  (civ-selected 1)
  (goal ce-personality ce-ALLY)
  (or
  (or (players-tribute any-human-neutral wood >= 100) (players-tribute any-human-neutral food >= 100))
  (or (players-tribute any-human-neutral gold >= 100) (players-tribute any-human-neutral stone >= 100))
)
  =>
  (chat-to-player-using-id this-any-human-neutral 942002)
  (chat-to-player-using-id this-any-human-neutral 942003)
  (set-stance this-any-human-neutral ally)
  (set-stance every-computer enemy)
  (disable-self)
)
#end-if
