; REBEL/dip-feeder/1
(defrule
  (civ-selected 2)
  (difficulty < easy)
  (game-time < 30)
  (or (player-computer any-ally) (player-human any-ally))
  =>
  (set-goal cr-personality cr-NOTICE)
  (disable-self)
)
; REBEL/dip-feeder/2
(defrule
  (civ-selected 2)
  (game-time > 30)
  (not (player-in-game any-ally))
  =>
  (set-goal cr-personality 0)
  (disable-self)
)
; REBEL/dip-feeder/3
(defrule
  (civ-selected 2)
  (taunt-detected any-ally 221)
  =>
  (set-goal cr-rush-control cr-CASTLE)
  (set-goal cr-personality 0)
  (acknowledge-taunt this-any-ally 221)
  (disable-self)
)
; REBEL/dip-feeder/4
(defrule
  (civ-selected 2)
  (goal cr-personality cr-NOTICE)
  =>
  (set-goal cr-personality 1)
  (chat-to-player-using-id every-ally 942401)
  (disable-self)
)
; REBEL/dip-feeder/5
(defrule
  (civ-selected 2)
  (goal cr-personality 1)
  (current-age < 3)
  (not (goal cr-rush-control cr-IMPERIAL))
  =>
  (set-goal cr-rush-control cr-IMPERIAL)
)
; REBEL/dip-feeder/6
(defrule
  (civ-selected 2)
  (goal cr-personality 1)
  (goal cr-wonder-attempt cr-POSSIBLE)
  =>
  (set-goal cr-wonder-attempt cr-NO)
)
; REBEL/dip-feeder/7
(defrule
  (civ-selected 2)
  (goal cr-personality 1)
  (or (and (current-age == 1) (players-current-age any-ally >= 2)) (and (current-age == 2) (players-current-age any-ally == 3)))
  =>
  (set-goal cr-upgrade-conflict cr-NOTICE)
)
; REBEL/dip-feeder/8
(defrule
  (civ-selected 2)
  (goal cr-personality 1)
  (building-type-count cr-bldg-spaceport > 0)
  (players-population any-ally > 10)
  =>
  (chat-to-player-using-id every-ally 942072)
  (disable-self)
)
; REBEL/dip-feeder/9
(defrule
  (civ-selected 2)
  (goal cr-personality 1)
  (game-time > 900)
  (or (players-population every-ally <= 10) (not (player-in-game any-ally)))
  =>
  (set-goal cr-personality 20)
  (set-goal cr-rush-control cr-IMPERIAL)
  (chat-to-player-using-id every-ally 942074)
  (disable-self)
)
#load-if-not-defined TEAMS-LOCKED
; REBEL/dip-feeder/10
(defrule
  (civ-selected 2)
  (goal cr-personality 20)
  (difficulty <= hard)
  (players-stance any-human ally)
  =>
  (chat-to-player-using-id every-ally 942075)
  (set-stance every-computer ally)
  (set-stance this-any-human enemy)
  (set-goal cr-personality 10)
  (disable-self)
)
#end-if
; REBEL/dip-feeder/11
(defrule
  (civ-selected 2)
  (true)
  =>
  (set-goal 29 cr-YES)
  (disable-self)
)
; REBEL/dip-feeder/12
(defrule
  (civ-selected 2)
  (goal cr-personality 1)
  (goal 29 cr-NO)
  =>
  (set-goal 29 cr-YES)
)
; REBEL/dip-feeder/13
(defrule
  (civ-selected 2)
  (goal cr-personality 1)
  (town-under-attack)
  =>
  (set-goal 29 cr-NO)
)
; REBEL/dip-feeder/14
(defrule
  (civ-selected 2)
  (goal cr-personality 1)
  (goal 29 cr-YES)
  (taunt-detected any-ally 4)
  (wood-amount > 100)
  =>
  (release-escrow wood)
  (tribute-to-player this-any-ally wood 100)
  (acknowledge-taunt this-any-ally 4)
  (chat-local-to-self "Tribute carbon")
)
