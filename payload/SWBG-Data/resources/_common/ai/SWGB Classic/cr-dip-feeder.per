  (civ-selected 2)
  (goal cr-personality 1)
  (goal 29 cr-YES)
  (player-in-game any-ally)
  (building-type-count cr-bldg-spaceport > 0)
  (up-compare-goal 116 c:< 240)
  (wood-amount > 300)
  =>
  (release-escrow wood)
  (tribute-to-player this-any-ally wood 100)
  (chat-to-player-using-id this-any-ally 942076)
  (chat-local-to-self "Tribute carbon")
)
